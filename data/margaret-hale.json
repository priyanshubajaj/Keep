  "timeline": [
    { "year": 1855, "event": "Born in Helstone, Hampshire",    "segmentId": "seg_001", "segmentText": "I was born in the parsonage at Helstone on a morning in September when the mist sat low on the churchyard." },
    { "year": 1863, "event": "Father begins teaching her Greek","segmentId": "seg_014", "segmentText": "My father decided, with characteristic suddenness, that I was old enough to learn Greek. I was eight." },
    { "year": 1871, "event": "First journey to London",         "segmentId": "seg_031", "segmentText": "The train to London was the loudest thing I had ever heard." },
    { "year": 1878, "event": "Family moves to Milton",          "segmentId": "seg_048", "segmentText": "We arrived in Milton on a grey November morning. The smoke from the mills sat over the town like a judgment." },
    { "year": 1879, "event": "Death of her mother",            "segmentId": "seg_057", "segmentText": "My mother died in February. She had been ill for months, but still the morning surprised me." },
    { "year": 1882, "event": "Begins writing memoir",          "segmentId": "seg_072", "segmentText": "I began writing not because I thought anyone would read it, but because the memories were becoming too heavy to carry only in my head." },
    { "year": 1891, "event": "Returns to Helstone",            "segmentId": "seg_089", "segmentText": "The village had changed less than I had. I stood at the gate of the parsonage for a long time before I went in." },
    { "year": 1903, "event": "Memoir published",               "segmentId": "seg_103", "segmentText": "The book appeared in October, a small edition, with a green cover I had not chosen." },
    { "year": 1935, "event": "Final chapter added",            "segmentId": "seg_121", "segmentText": "I am adding this at eighty. I had thought I was done, but there is one more thing I want to say." },
    { "year": 1937, "event": "Died at Helstone, age 81",       "segmentId": "seg_127", "segmentText": "She died as she had wished, in the village she had loved most." }
